# /etc/busradar/busradar.env — Busradar runtime secrets + HAFAS sources.
# NOT in git or the RPM. Create it on the host from this template, then:
#   chown root:busradar /etc/busradar/busradar.env
#   chmod 0640 /etc/busradar/busradar.env
# systemd loads it via EnvironmentFile=-/etc/busradar/busradar.env.
# One line per variable; JSON values must be single-line.
#
# CARTO Basemaps API key (charset [A-Za-z0-9_-]; other chars are stripped).
# Empty/unset → the map falls back (CARTO watermark / OSM), still functional.
BUSRADAR_CARTO_KEY=REPLACE_ME
#
# HAFAS sources as a single-line JSON array. Each source needs at least an
# "endpoint" (must be an https URL) and an "aid"; add "client"/"ext"/"ver"/
# "products" as the respective HAFAS installation requires. The runtime uses
# the source tagged id "bw" (else the first). Append further objects to the
# array to configure additional regions.
BUSRADAR_HAFAS_SOURCES=[{"id":"bw","endpoint":"https://REPLACE_ME/bin/mgate.exe","aid":"REPLACE_ME","client":{"type":"AND","id":"REPLACE_ME","v":"REPLACE_ME","name":"REPLACE_ME"},"ext":"REPLACE_ME","ver":"REPLACE_ME","products":{"bus":32}}]
